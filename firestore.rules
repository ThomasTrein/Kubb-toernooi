rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Iedereen mag alle toernooigegevens lezen (publieke standen/schema/bracket).
    // Alleen "geauthenticeerde" sessies (na correcte admin-PIN, zie src/lib/admin-auth.ts)
    // mogen schrijven. Let op: dit is een lichte beveiliging passend bij een
    // vriendschappelijk buurttoernooi, geen zware beveiliging tegen een vastberaden
    // aanvaller. Zie README.md voor meer uitleg.
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow write: if request.auth != null;

      match /{subcollection=**} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }
  }
}
